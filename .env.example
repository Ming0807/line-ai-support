# Recommended modern Supabase keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Optional legacy compatibility keys; client setup should prefer modern keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DATABASE_URL=
DIRECT_URL=
DATABASE_SSL_CA_PATH=
SUPABASE_DIRECT_DATABASE_URL=
# Required only by development provisioning scripts; never point them at production.
YRU_DEPLOYMENT_ENV=
DEV_SUPABASE_PROJECT_REF=

APP_BASE_URL=http://localhost:3000
DEFAULT_AI_TIMEOUT_MS=20000
HARD_AI_TIMEOUT_MS=45000
# A base64-encoded, random 32-byte key; server-only
ENCRYPTION_KEY=

LINE_STUDENT_CHANNEL_SECRET=
LINE_STUDENT_CHANNEL_ACCESS_TOKEN=
LINE_STAFF_CHANNEL_SECRET=
LINE_STAFF_CHANNEL_ACCESS_TOKEN=
# echo preserves the original verification demo; durable requires DB + worker.
LINE_WEBHOOK_MODE=echo
# Enable only after the AI-job migrations, worker and reviewed knowledge are ready.
YRU_AI_ENABLED=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_API_URL=http://127.0.0.1:8000
# Required for non-loopback authenticated HTTPS deployments; server-only.
EMBEDDING_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Generation providers/models are configured by Super Admin at /providers.
# Embeddings are infrastructure; service cache is configured in services/embedding/.env.
# AI_* fields above are reserved for optional bootstrap; no bootstrap runs automatically.
