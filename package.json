{
  "name": "yru-helpdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "local:test": "node --import tsx scripts/local/run.mjs",
    "local:staff": "node --import tsx scripts/local/run.mjs --staff-test",
    "local:ai": "node --import tsx scripts/local/run.mjs --assistant-preview",
    "local:check": "node --import tsx scripts/local/run.mjs --check",
    "local:stop": "node --import tsx scripts/local/run.mjs --stop",
    "hermes:test": "node --import tsx scripts/ai/hermes-pilot.ts --synthetic",
    "hermes:copilot": "node --import tsx scripts/ai/hermes-copilot-pilot.ts --copilot",
    "qa:prescreen": "node --import tsx scripts/qa/qa-pre-screener.ts",
    "qa:knowledge-gaps": "node --import tsx scripts/qa/knowledge-gap-miner.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "powershell -NoProfile -File scripts/database/test-local.ps1",
    "worker": "tsx scripts/worker.ts",
    "worker:outbox": "tsx scripts/outbox-worker.ts",
    "worker:ai": "tsx scripts/ai-worker.ts",
    "worker:incidents": "tsx scripts/incident-worker.ts",
    "worker:media": "tsx scripts/media-worker.ts",
    "storage:chat:setup": "tsx scripts/storage/provision-chat-media.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "dotenv": "18.0.5",
    "next": "16.3.8",
    "parse5": "8.0.1",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.23.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
